{
  "rules": {
    ".read": false,
    ".write": false,
    "stats": {
      ".read": true,
      "$module": {
        ".validate": "$module.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren()",
        "views": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "ops": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 300"
        },
        "seconds": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 180"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "clock": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() === now"
    },
    "online": {
      ".read": true,
      ".indexOn": [
        "k"
      ],
      "$min": {
        ".write": "newData.exists() || !data.exists() || data.child('k').val() * 60000 < now - 600000",
        ".validate": "$min.matches(/^[0-9]{8}$/) && newData.hasChildren(['k', 'n'])",
        "k": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : (newData.val() * 60000 <= now + 60000 && newData.val() * 60000 >= now - 180000))"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "m": {
          "$mod": {
            ".validate": "$mod.matches(/^[a-z0-9-]{1,40}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      ".read": true,
      ".indexOn": [
        "t"
      ],
      "$sid": {
        ".write": true,
        ".validate": "$sid.matches(/^[a-z0-9]{16}$/) && newData.hasChildren(['t', 'm'])",
        "t": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "comments": {
      "$module": {
        ".read": true,
        ".indexOn": [
          "createdAt"
        ],
        "$cid": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)))",
          ".validate": "$module.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['uid', 'nickname', 'text', 'createdAt']) && newData.parent().parent().parent().child('rateLimit').child(auth.uid).val() === now",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "nickname": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rateLimit": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 20000)"
      }
    },
    "profiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "$other": {
          ".validate": false
        },
        "pub": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "reports": {
      ".read": true,
      "$module": {
        "$cid": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true && root.child('comments').child($module).child($cid).exists()"
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "missionDefs": {
      ".read": true,
      "$mid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "$mid.matches(/^[a-z0-9-]{1,60}$/) && newData.hasChildren(['stars']) && newData.child('stars').isNumber() && newData.child('stars').val() >= 1 && newData.child('stars').val() <= 20"
      }
    },
    "completions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['stars', 'at']) && root.child('missionDefs').child($mid).exists() && newData.child('stars').val() === root.child('missionDefs').child($mid).child('stars').val() && newData.child('at').val() === now && newData.parent().parent().parent().child('scores').child($uid).child('last').val() === $mid",
          "stars": {},
          "at": {},
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "bonus": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$mid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && root.child('completions').child($uid).child($mid).exists() && root.child('completions').child($uid).child($mid).child('stars').val() + newData.val() === root.child('missionDefs').child($mid).child('stars').val() && newData.parent().parent().parent().child('scores').child($uid).child('last').val() === $mid"
        }
      }
    },
    "scores": {
      ".read": true,
      ".indexOn": [
        "stars",
        "s/phy",
        "s/chem",
        "s/bio",
        "s/earth",
        "s/math",
        "s/info",
        "s/geog",
        "s/music"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['stars', 'name', 'last', 'pub']) && newData.child('stars').isNumber() && ((data.exists() && newData.child('stars').val() === data.child('stars').val() && newData.child('last').val() === data.child('last').val()) || (!root.child('completions').child($uid).child(newData.child('last').val()).exists() && newData.parent().parent().child('completions').child($uid).child(newData.child('last').val()).exists() && newData.child('stars').val() === (data.exists() ? data.child('stars').val() : 0) + root.child('missionDefs').child(newData.child('last').val()).child('stars').val()) || (data.exists() && root.child('completions').child($uid).child(newData.child('last').val()).exists() && newData.parent().parent().child('bonus').child($uid).child(newData.child('last').val()).exists() && newData.child('stars').val() === data.child('stars').val() + newData.parent().parent().child('bonus').child($uid).child(newData.child('last').val()).val() - (root.child('bonus').child($uid).child(newData.child('last').val()).exists() ? root.child('bonus').child($uid).child(newData.child('last').val()).val() : 0))) && (!data.child('s').exists() || newData.child('s').exists())",
        "stars": {},
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "last": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,60}$/)"
        },
        "pub": {
          ".validate": "newData.isBoolean()"
        },
        "at": {},
        "s": {
          ".validate": "newData.hasChildren() && (newData.child('phy').exists() ? newData.child('phy').val() : 0) + (newData.child('chem').exists() ? newData.child('chem').val() : 0) + (newData.child('bio').exists() ? newData.child('bio').val() : 0) + (newData.child('earth').exists() ? newData.child('earth').val() : 0) + (newData.child('math').exists() ? newData.child('math').val() : 0) + (newData.child('info').exists() ? newData.child('info').val() : 0) + (newData.child('geog').exists() ? newData.child('geog').val() : 0) + (newData.child('music').exists() ? newData.child('music').val() : 0) <= newData.parent().child('stars').val()",
          "$subj": {
            ".validate": "$subj.matches(/^(phy|chem|bio|earth|math|info|geog|music)$/) && newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0)"
          }
        },
        "sa": {
          "$subj": {
            ".validate": "$subj.matches(/^(phy|chem|bio|earth|math|info|geog|music)$/) && newData.isNumber() && (newData.val() === now || (data.exists() && newData.val() === data.val()))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userStats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        "ops": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 300"
        },
        "seconds": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 180"
        },
        "modules": {
          "$m": {
            ".validate": "$m.matches(/^[a-z0-9-]{1,40}$/) && newData.val() === true"
          }
        },
        "days": {
          "$d": {
            ".validate": "$d.matches(/^[0-9]{8}$/)",
            "$m": {
              ".validate": "$m.matches(/^[a-z0-9-]{1,40}$/) && newData.val() === true"
            }
          }
        },
        "flags": {
          "$f": {
            ".validate": "$f.matches(/^[a-z]{1,20}$/) && newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        },
        "comments": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "achievements": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$aid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "$aid.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['at']) && newData.child('at').val() === now",
          "at": {},
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "daily": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['d', 'picks', 'n', 'at']) && newData.child('at').val() === now && newData.child('d').isNumber() && newData.child('d').val() * 86400000 <= now + 28800000 && now + 28800000 < (newData.child('d').val() + 1) * 86400000 && newData.child('n').isNumber() && newData.child('n').val() >= 0 && newData.child('n').val() <= 10 && ((data.exists() && data.child('d').val() === newData.child('d').val()) ? (newData.child('n').val() === data.child('n').val() || (newData.child('n').val() === data.child('n').val() + 1 && now - data.child('at').val() >= 10000)) : newData.child('n').val() <= 1)",
        "d": {},
        "n": {},
        "at": {},
        "picks": {
          "$k": {
            ".validate": "$k.matches(/^([0-9]|easy|mid|hard)$/) && newData.isString() && newData.val().matches(/^[a-z0-9-]{1,60}$/) && (!data.exists() || data.val() === newData.val() || data.parent().parent().child('d').val() !== newData.parent().parent().child('d').val())"
          }
        },
        "done": {
          "$mid": {
            ".validate": "$mid.matches(/^[a-z0-9-]{1,60}$/) && newData.val() === true && (data.exists() || newData.parent().parent().child('n').val() === (data.parent().parent().child('d').val() === newData.parent().parent().child('d').val() ? data.parent().parent().child('n').val() + 1 : 1))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bag": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.parent().parent().child('daily').child($uid).child('at').val() === now && newData.parent().parent().child('daily').child($uid).child('n').val() >= 1 && (newData.parent().parent().child('daily').child($uid).child('d').val() !== root.child('daily').child($uid).child('d').val() || newData.parent().parent().child('daily').child($uid).child('n').val() === root.child('daily').child($uid).child('n').val() + 1)",
        ".validate": "(newData.child('cu').val() !== data.child('cu').val() ? 1 : 0) + (newData.child('ag').val() !== data.child('ag').val() ? 1 : 0) + (newData.child('au').val() !== data.child('au').val() ? 1 : 0) + (newData.child('dia').val() !== data.child('dia').val() ? 1 : 0) + (newData.child('key').val() !== data.child('key').val() ? 1 : 0) <= 1",
        "cu": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 5"
        },
        "ag": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 3"
        },
        "au": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 2"
        },
        "dia": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "key": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "dm": {
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
