{
  "rules": {
    ".read": false,
    ".write": false,

    "stats": {
      ".read": true,
      "$module": {
        ".validate": "$module.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren()",
        "views": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "ops": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 300"
        },
        "seconds": {
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 180"
        },
        "$other": { ".validate": false }
      }
    },

    "comments": {
      "$module": {
        ".read": true,
        ".indexOn": ["createdAt"],
        "$cid": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)))",
          ".validate": "$module.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['uid', 'nickname', 'text', 'createdAt']) && newData.parent().parent().parent().child('rateLimit').child(auth.uid).val() === now",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "nickname": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "rateLimit": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 20000)"
      }
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "nickname": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "$other": { ".validate": false }
      }
    },

    "reports": {
      ".read": true,
      "$module": {
        "$cid": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true && root.child('comments').child($module).child($cid).exists()"
          }
        }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
